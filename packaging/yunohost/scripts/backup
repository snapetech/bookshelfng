#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

service_was_active=false

finish_backup() {
    local exit_code=$?
    trap - EXIT
    if [[ "$service_was_active" == true ]]; then
        ynh_systemctl --service="$app" --action="start" || exit_code=$?
    fi
    if [[ "$exit_code" == 0 ]]; then
        true
    else
        false && true
    fi
    ynh_exit_properly
}

trap finish_backup EXIT

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_print_info "Preparing a consistent BookshelfNG backup..."

if systemctl is-active --quiet "$app"; then
    service_was_active=true
    ynh_print_info "Stopping BookshelfNG for a consistent database snapshot..."
    ynh_systemctl --service="$app" --action="stop"
fi

#=================================================
# BACKUP THE DATA DIR
#=================================================
ynh_print_info "Snapshotting BookshelfNG configuration and database..."

mkdir -p "$YNH_APP_BACKUP_DIR/data"
rsync --archive --delete \
    --exclude="/cache/" \
    --exclude="/logs/" \
    "$data_dir/" "$YNH_APP_BACKUP_DIR/data/"

#=================================================
# BACKUP THE APP MAIN DIR
#=================================================
ynh_print_info "Declaring BookshelfNG files for backup..."

ynh_backup "$install_dir"

#=================================================
# BACKUP SYSTEM CONFIGURATION
#=================================================
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"

#=================================================
# END OF SCRIPT
#=================================================
ynh_print_info "BookshelfNG backup declaration completed"
